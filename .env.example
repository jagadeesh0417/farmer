# ── Frontend (set in Vercel Dashboard) ──
# Backend API URL — set this to your Render backend URL.
# The frontend auto-appends /api, so use the base URL without /api.
# Example: https://your-app.onrender.com
VITE_API_URL=https://your-app.onrender.com

# ── Backend (set in Render Dashboard) ──
# Server port (Render injects PORT automatically; Vercel serverless ignores this)
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb+srv://farmer:Jagadeesh2005@cluster0.2dmqh1j.mongodb.net/haifarmer?appName=Cluster0

# JWT — used to sign and verify admin tokens
JWT_SECRET=haifarmer_jwt_secret_change_in_production_2026
JWT_EXPIRES_IN=7d

# CORS — frontend origin(s) allowed to call the API (comma-separated)
CORS_ORIGIN=http://localhost:5173,https://farmer-umber.vercel.app

# Cloudinary — image uploads
CLOUDINARY_URL=cloudinary://571427364946158:8cst_AHfIgdBuFcs1YJRdsvSiZU@drp7pfa2w
CLOUDINARY_CLOUD_NAME=drp7pfa2w
CLOUDINARY_API_KEY=571427364946158
CLOUDINARY_API_SECRET=8cst_AHfIgdBuFcs1YJRdsvSiZU

